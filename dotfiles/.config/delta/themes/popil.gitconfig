[delta "popil"]
blame-palette = "#1f1f1e #1a1a19 #151514 #292929 #323232"
commit-decoration-style = "#57534e" bold box ul
dark = true
file-decoration-style = "#57534e"
file-style = "#e4e2de"
hunk-header-decoration-style = "#57534e" box ul
hunk-header-file-style = bold
hunk-header-line-number-style = bold "#9b958a"
hunk-header-style = file line-number syntax
line-numbers-left-style = "#57534e"
line-numbers-minus-style = bold "#ec7470"
line-numbers-plus-style = bold "#91ab78"
line-numbers-right-style = "#57534e"
line-numbers-zero-style = "#57534e"
minus-emph-style = bold syntax "#673d3b"
minus-style = syntax "#48302e"
plus-emph-style = bold syntax "#47503e"
plus-style = syntax "#363b30"
map-styles = \
bold purple => syntax "#514557", \
bold blue => syntax "#464f5d", \
bold cyan => syntax "#344f58", \
bold yellow => syntax "#5e5034"
syntax-theme = popil
