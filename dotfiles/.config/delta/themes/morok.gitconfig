[delta "morok"]
blame-palette = "#111111 #0d0d0d #000000 #1b1b1b #262626"
commit-decoration-style = "#57534e" bold box ul
dark = true
file-decoration-style = "#57534e"
file-style = "#e7e5e4"
hunk-header-decoration-style = "#57534e" box ul
hunk-header-file-style = bold
hunk-header-line-number-style = bold "#a8a29e"
hunk-header-style = file line-number syntax
line-numbers-left-style = "#57534e"
line-numbers-minus-style = bold "#df7c7b"
line-numbers-plus-style = bold "#8aaf86"
line-numbers-right-style = "#57534e"
line-numbers-zero-style = "#57534e"
minus-emph-style = bold syntax "#593636"
minus-style = syntax "#3a2626"
plus-emph-style = bold syntax "#3b483a"
plus-style = syntax "#293128"
map-styles = \
bold purple => syntax "#473b4f", \
bold blue => syntax "#3c4351", \
bold cyan => syntax "#25444e", \
bold yellow => syntax "#554932"
syntax-theme = morok
