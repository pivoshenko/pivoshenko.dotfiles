[delta "vatra"]
blame-palette = "#1f1f1f #1a1a1a #151515 #2a2928 #353230"
commit-decoration-style = "#5b524b" bold box ul
dark = true
file-decoration-style = "#5b524b"
file-style = "#f3e0ba"
hunk-header-decoration-style = "#5b524b" box ul
hunk-header-file-style = bold
hunk-header-line-number-style = bold "#aa9983"
hunk-header-style = file line-number syntax
line-numbers-left-style = "#5b524b"
line-numbers-minus-style = bold "#f7716e"
line-numbers-plus-style = bold "#a6bc6a"
line-numbers-right-style = "#5b524b"
line-numbers-zero-style = "#5b524b"
minus-emph-style = bold syntax "#6b3c3b"
minus-style = syntax "#4a2f2f"
plus-emph-style = bold syntax "#4e5639"
plus-style = syntax "#3a3e2e"
map-styles = \
bold purple => syntax "#55465e", \
bold blue => syntax "#414e5d", \
bold cyan => syntax "#315663", \
bold yellow => syntax "#63542f"
syntax-theme = vatra
