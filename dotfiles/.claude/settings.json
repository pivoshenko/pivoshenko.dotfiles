{
  "advisorModel": "fable",
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoContinueAtUsageLimit": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Running `ssh` (and `scp`) against the user's own servers, such as the production box reached over Tailscale, including deploy, restart and maintenance commands",
      "Triggering GitHub Actions workflows with `gh workflow run` in the user's own repositories, including release and production deploy workflows, and watching or inspecting them with `gh run`"
    ]
  },
  "cleanupPeriodDays": 14,
  "effortLevel": "high",
  "enabledPlugins": {},
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/volodymyr.pivoshenko/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "inputNeededNotifEnabled": true,
  "outputStyle": "Concise",
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(herdr:*)",
      "Bash(just:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(pnpm:*)",
      "Bash(pwd)",
      "Bash(rg:*)",
      "Bash(rm:*)",
      "Bash(ssh:*)",
      "Bash(terraform:*)",
      "Bash(touch:*)",
      "Bash(uv:*)",
      "Bash(which:*)",
      "Edit",
      "NotebookEdit",
      "Write"
    ],
    "defaultMode": "auto"
  },
  "precomputeCompactionEnabled": true,
  "showThinkingSummaries": false,
  "skillListingBudgetFraction": 0.02,
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "spinnerTipsEnabled": false,
  "statusLine": {
    "command": "sh ~/.claude/statusline-command.sh",
    "type": "command"
  },
  "theme": "dark-ansi",
  "tui": "fullscreen",
  "voice": {
    "autoSubmit": true,
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true
}
