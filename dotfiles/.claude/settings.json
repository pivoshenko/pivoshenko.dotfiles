{
  "skillListingBudgetFraction": 0.02,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(mkdir:*)",
      "Bash(rm:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(which:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(pnpm:*)",
      "Bash(uv:*)",
      "Bash(just:*)",
      "Bash(terraform:*)",
      "Bash(curl:*)",
      "Bash(herdr:*)",
      "Write",
      "Edit",
      "NotebookEdit"
    ],
    "defaultMode": "auto"
  },
  "includeCoAuthoredBy": false,
  "tui": "fullscreen",
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {},
  "effortLevel": "high",
  "outputStyle": "Concise",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "showThinkingSummaries": false,
  "spinnerTipsEnabled": false,
  "cleanupPeriodDays": 14,
  "precomputeCompactionEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "voice": {
    "enabled": true,
    "mode": "hold",
    "autoSubmit": true
  },
  "skipAutoPermissionPrompt": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/volodymyr.pivoshenko/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
